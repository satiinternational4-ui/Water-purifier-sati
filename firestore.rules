rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unknown collections
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    function isValidProduct(data) {
      return data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() > 0 && data.name.size() <= 256
        && data.category is string && data.category.size() <= 64
        && data.price is number && data.price >= 0
        && data.image is string && data.image.size() <= 1048576
        && data.inStock is bool;
    }

    // Products catalog:
    // Public read so any website visitor across any domain/device can view products.
    // Writes are open or authenticated for catalog synchronizations from the host.
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isValidId(productId) && isValidProduct(request.resource.data);
      allow delete: if isValidId(productId);
    }
  }
}
